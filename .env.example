# Local development only. Use URL-safe passwords (letters, digits, underscore).
POSTGRES_PASSWORD=local_bootstrap_password
MIGRATION_PASSWORD=local_migration_password
RUNTIME_PASSWORD=local_runtime_password
RABBITMQ_USER=commandix
RABBITMQ_PASSWORD=local_broker_password
OUTBOX_PUBLISH_CONFIRM_TIMEOUT_MS=5000
JWT_SECRET=local_development_jwt_secret_32_chars
AUTH_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
AUTH_COOKIE_SECURE=false
WEB_PORT=8080
RABBITMQ_MANAGEMENT_PORT=15672
