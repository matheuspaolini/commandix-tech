{
  "name": "commandix",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@nestjs/common": "^11.1.0",
      "@nestjs/core": "^11.1.0",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.2",
      "pg": "^8.16.0",
      "@types/pg": "^8.15.0",
      "@types/bun": "^1.3.0",
      "typescript": "~5.9.3"
    }
  },
  "scripts": {
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "typecheck": "bun run generate && bun run --filter '*' typecheck",
    "generate": "bun run --filter @commandix/database generate",
    "build": "bun run typecheck && bun run --filter @commandix/web build",
    "test": "bun run --filter @commandix/api test && bun run --filter @commandix/worker test && bun run --filter @commandix/web test",
    "db:migrate": "bun run --filter @commandix/database migrate",
    "db:seed": "bun run --filter @commandix/api seed",
    "check": "bun run format:check && bun run typecheck && bun run build && bun run test",
    "test:stack": "bash scripts/test-stack.sh"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  }
}
