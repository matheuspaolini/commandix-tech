generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ContractHistoryAction {
  CREATED
  ACTIVATED
}

enum OutboxFailureReason {
  RETURNED
  NACKED
  CONFIRM_TIMEOUT
  CONNECTION_LOST
}

model Tenant {
  id               String            @id @default(uuid()) @db.Uuid
  slug             String            @unique
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  users            User[]
  logicalTemplate  LogicalTemplate?
  templateVersions TemplateVersion[]
  contracts        Contract[]
  contractHistory  ContractHistory[]
  notificationLogs NotificationLog[]
  activationOutbox ContractActivationOutbox[]

  @@map("tenants")
}

model LogicalTemplate {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @unique @map("tenant_id") @db.Uuid
  revision        Int               @default(1)
  activeVersionId String?           @unique @map("active_version_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versions        TemplateVersion[] @relation("TemplateVersions")
  activeVersion   TemplateVersion?  @relation("ActiveTemplateVersion", fields: [activeVersionId, id, tenantId], references: [id, logicalTemplateId, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([activeVersionId, id, tenantId])
  @@map("logical_templates")
}

model TemplateVersion {
  id                String           @id @default(uuid()) @db.Uuid
  logicalTemplateId String           @map("logical_template_id") @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  definition        Json
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  logicalTemplate   LogicalTemplate  @relation("TemplateVersions", fields: [logicalTemplateId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  activeFor         LogicalTemplate? @relation("ActiveTemplateVersion")
  contracts         Contract[]

  @@unique([id, tenantId])
  @@unique([id, logicalTemplateId, tenantId])
  @@index([logicalTemplateId, tenantId])
  @@map("template_versions")
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  email           String
  passwordHash    String            @map("password_hash")
  role            UserRole
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refreshSessions RefreshSession[]
  contractHistory ContractHistory[]

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@map("users")
}

model Contract {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  templateVersionId String            @map("template_version_id") @db.Uuid
  status            ContractStatus    @default(DRAFT)
  revision          Int               @default(1)
  values            Json
  createdAt         DateTime          @map("created_at") @db.Timestamptz(6)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  templateVersion   TemplateVersion   @relation(fields: [templateVersionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  history           ContractHistory[]
  notificationLogs NotificationLog[]
  activationOutbox ContractActivationOutbox[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@map("contracts")
}

model ContractActivationOutbox {
  eventId            String               @id @map("event_id") @db.Uuid
  eventType          String               @map("event_type")
  schemaVersion      Int                  @map("schema_version")
  tenantId           String               @map("tenant_id") @db.Uuid
  contractId         String               @map("contract_id") @db.Uuid
  activationRevision Int                  @map("activation_revision")
  occurredAt         DateTime             @map("occurred_at") @db.Timestamptz(3)
  correlationId      String               @map("correlation_id") @db.Uuid
  attemptCount       Int                  @default(0) @map("attempt_count")
  lastAttemptAt      DateTime?            @map("last_attempt_at") @db.Timestamptz(6)
  nextAttemptAt      DateTime             @map("next_attempt_at") @db.Timestamptz(6)
  publishedAt        DateTime?            @map("published_at") @db.Timestamptz(6)
  failureReason      OutboxFailureReason? @map("failure_reason")
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract            Contract             @relation(fields: [contractId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, contractId, activationRevision])
  @@map("contract_activation_outbox")
}

model NotificationLog {
  eventId            String   @id @map("event_id") @db.Uuid
  eventType          String   @map("event_type")
  schemaVersion      Int      @map("schema_version")
  tenantId           String   @map("tenant_id") @db.Uuid
  contractId         String   @map("contract_id") @db.Uuid
  activationRevision Int      @map("activation_revision")
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(3)
  correlationId      String   @map("correlation_id") @db.Uuid
  processedAt        DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract            Contract @relation(fields: [contractId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, contractId])
  @@map("notification_logs")
}

model ContractHistory {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  contractId     String                @map("contract_id") @db.Uuid
  actorId        String                @map("actor_id") @db.Uuid
  action         ContractHistoryAction
  revision       Int
  occurredAt     DateTime              @map("occurred_at") @db.Timestamptz(6)
  beforeSnapshot Json?                 @map("before_snapshot")
  afterSnapshot  Json                  @map("after_snapshot")
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract       Contract              @relation(fields: [contractId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actor          User                  @relation(fields: [actorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, contractId, revision])
  @@index([tenantId, contractId, revision])
  @@map("contract_history")
}

model RefreshSession {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  createdAt   DateTime            @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?           @map("revoked_at") @db.Timestamptz(6)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  credentials RefreshCredential[]

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model RefreshCredential {
  selector   String         @id @db.Uuid
  sessionId  String         @map("session_id") @db.Uuid
  secretHash String         @map("secret_hash")
  generation Int
  parentId   String?        @unique @map("parent_id") @db.Uuid
  issuedAt   DateTime       @map("issued_at") @db.Timestamptz(6)
  consumedAt DateTime?      @map("consumed_at") @db.Timestamptz(6)
  session    RefreshSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, generation])
  @@index([sessionId])
  @@map("refresh_credentials")
}
